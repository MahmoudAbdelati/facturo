# Postgres connection string (Neon, Supabase, local, ...).
# SSL is required unless the URL ends in ?sslmode=disable.
POSTGRES_URL=

# Generate with: npx auth secret
AUTH_SECRET=

# Demo account created by `pnpm db:seed`
DEMO_EMAIL=demo@facturo.app
DEMO_PASSWORD=facturo-demo

# Public URL of the site, for absolute links in metadata (social cards).
# Optional on Vercel, which provides the production domain.
SITE_URL=

# Protects /api/cron/reset-demo, which Vercel Cron calls nightly to reset the demo.
# Any long random string; set it on Vercel (production).
CRON_SECRET=
